---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Experience from '../components/Experience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { portfolio } from '../data/portfolio.js';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: portfolio.name,
  url: portfolio.siteUrl,
  jobTitle: 'Technical Solutions Consultant',
  description: portfolio.description,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Georgia Institute of Technology',
  },
  sameAs: [portfolio.contact.linkedinUrl, portfolio.contact.githubUrl],
  knowsAbout: [
    'Technical solutions consulting',
    'Advertising technology',
    'Cloud architecture',
    'Data analytics',
    'Generative AI',
    'API integrations',
  ],
};
---

<BaseLayout schema={personSchema}>
  <Hero portfolio={portfolio} />
  <Metrics metrics={portfolio.metrics} />

  <section class="section shell split-section" id="about" aria-labelledby="about-title">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">01 · {portfolio.about.eyebrow}</p>
      <h2 id="about-title">{portfolio.about.heading}</h2>
    </div>
    <div class="body-copy" data-reveal>
      {portfolio.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="credential">B.S. Computer Science · Georgia Institute of Technology · 2022</p>
    </div>
  </section>

  <section class="section section-bordered shell" id="experience" aria-labelledby="experience-title">
    <div class="section-heading section-heading-wide" data-reveal>
      <p class="eyebrow">02 · Experience</p>
      <h2 id="experience-title">Four years bridging technical systems and customer decisions.</h2>
    </div>
    <Experience experience={portfolio.experience} />
  </section>

  <section class="section shell" id="work" aria-labelledby="work-title">
    <div class="section-heading work-heading" data-reveal>
      <div>
        <p class="eyebrow">03 · Selected work</p>
        <h2 id="work-title">Shipped projects with inspectable systems underneath.</h2>
      </div>
      <a class="text-link" href={portfolio.contact.githubUrl} target="_blank" rel="noreferrer">All GitHub projects ↗</a>
    </div>
    <div class="projects-grid">
      {portfolio.projects.map((project, index) => (
        <ProjectCard project={project} featured={index === 0} />
      ))}
    </div>
  </section>

  <section class="section section-bordered shell" id="skills" aria-labelledby="skills-title">
    <div class="section-heading section-heading-wide" data-reveal>
      <p class="eyebrow">04 · Capabilities</p>
      <h2 id="skills-title">Hands-on enough to build. Broad enough to align the room.</h2>
    </div>
    <Skills groups={portfolio.skillGroups} />
  </section>

  <section class="section shell" id="contact" aria-labelledby="contact-title">
    <h2 class="visually-hidden" id="contact-title">Contact Chris Johnson</h2>
    <Contact portfolio={portfolio} />
  </section>
</BaseLayout>
