---
import { portfolio } from '../data/portfolio.js';

const {
  title = portfolio.pageTitle,
  description = portfolio.description,
  canonicalPath = '/',
  image = '/assets/chris-johnson-og.png',
  schema = null,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, portfolio.siteUrl).toString();
const imageUrl = new URL(image, portfolio.siteUrl).toString();
const isHome = canonicalPath === '/';
const homePrefix = isHome ? '' : '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17140f" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={portfolio.name} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${portfolio.name} portfolio preview`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline src="/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-noise" aria-hidden="true"></div>

    <header class="site-header">
      <nav class="site-nav shell" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Chris Johnson home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Chris Johnson</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          Menu
        </button>
        <div class="nav-links" id="nav-links">
          <a href={`${homePrefix}#about`}>About</a>
          <a href={`${homePrefix}#experience`}>Experience</a>
          <a href={`${homePrefix}#work`}>Work</a>
          <a href={`${homePrefix}#contact`}>Contact</a>
          <a class="nav-resume" href={portfolio.resumeUrl}>Résumé</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>{portfolio.name}</strong>
          <p>{portfolio.positioning}</p>
        </div>
        <div class="footer-links">
          <a href={portfolio.contact.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={portfolio.contact.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a href="#main">Back to top</a>
        </div>
      </div>
    </footer>
  </body>
</html>
