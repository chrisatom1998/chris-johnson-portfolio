---
const { portfolio } = Astro.props;
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy" data-reveal>
    <p class="eyebrow">{portfolio.positioning}</p>
    <p class="hero-kicker">{portfolio.hero.kicker}</p>
    <h1 id="hero-title">{portfolio.hero.title}</h1>
    <p class="hero-body">{portfolio.hero.body}</p>
    <div class="button-row" aria-label="Primary actions">
      <a class="button button-primary" href="#work">View selected work</a>
      <a class="button button-secondary" href={portfolio.resumeUrl}>Download résumé</a>
      <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↘</span></a>
    </div>
    <p class="availability"><span aria-hidden="true"></span>{portfolio.hero.note}</p>
  </div>

  <div class="hero-visual" aria-hidden="true" data-reveal>
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <div class="orbit orbit-three"></div>
    <div class="visual-core">
      <span>CJ</span>
    </div>
    <span class="visual-node node-one"></span>
    <span class="visual-node node-two"></span>
    <span class="visual-node node-three"></span>
    <span class="visual-label label-data">Data</span>
    <span class="visual-label label-cloud">Cloud</span>
    <span class="visual-label label-ai">AI</span>
    <span class="visual-label label-customer">Customer</span>
  </div>
</section>
